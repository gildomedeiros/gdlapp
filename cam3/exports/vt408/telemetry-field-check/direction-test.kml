  "longitude": 0.001
}</description><ExtendedData><Data name="loggedTimestamp"><value>2</value></Data><Data name="sourceFile"><value>test</value></Data><Data name="sourceLine"><value>3</value></Data><Data name="latitude"><value>0</value></Data><Data name="longitude"><value>0.001</value></Data><Data name="travelBearingDegrees"><value>90.0</value></Data><Data name="previousCoordinateTimestamp"><value>1</value></Data><Data name="previousLatitude"><value>0</value></Data><Data name="previousLongitude"><value>0</value></Data><Data name="secondsSincePreviousCoordinate"><value>2.0</value></Data><Data name="travelDirectionStatus"><value>Bearing between recorded coordinates; not aircraft heading</value></Data><Data name="event"><value>lora_packet</value></Data><Data name="accepted"><value>True</value></Data></ExtendedData><Point><altitudeMode>clampToGround</altitudeMode><coordinates>0.001,0</coordinates></Point></Placemark></Folder><Style id="surfer_other"><IconStyle><color>ff0088ff</color><scale>0.65</scale><Icon><href>https://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon></IconStyle><LabelStyle><scale>0</scale></LabelStyle><LineStyle><color>ff0088ff</color><width>2</width></LineStyle></Style><Folder><name>Surfer — rejected or acceptance unknown</name></Folder><Style id="drone"><IconStyle><color>ffff8800</color><scale>0.65</scale><Icon><href>https://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon></IconStyle><LabelStyle><scale>0</scale></LabelStyle><LineStyle><color>ffff8800</color><width>2</width></LineStyle></Style><Folder><name>Drone — recorded position snapshots</name></Folder><Folder><name>Travel direction arrows (display only)</name><Placemark><name>surfer 2 — 90.0 deg — 2.000s gap</name><styleUrl>#surfer</styleUrl><description>Previous coordinate: 1 (0, 0)
